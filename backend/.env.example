APP_NAME=Generic Textbook Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=textbook_assistant

JWT_SECRET_KEY=replace-with-a-strong-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=textbook-assistant/videos

VIDEO_OUTPUT_DIR=outputs/videos
GENERATION_MOCK_DELAY_SECONDS=0.15

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=textbook_chunks
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Video assembly (Purnika) ---
VIDEO_FPS=24
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VMAKE_ENABLED=false
VMAKE_API_KEY=

# --- TTS / audio post-processing (Pallika) ---
AUDIO_TARGET_LUFS=-16.0
AUDIO_SILENCE_THRESHOLD_DB=-45.0
AUDIO_POSTPROCESS_ENABLED=true
VIDEO_PRESET=veryfast
VIDEO_THREADS=0

# --- LLM Configuration (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

# --- Clerk auth (from the Clerk dashboard → API keys) ---
CLERK_SECRET_KEY=

# --- AI fallback providers (app/llm/llm_router.py) ---
# Each task tries providers in order and moves on when one is rate-limited or down.
# Any provider left empty is simply skipped.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- NEET PYQ extraction (backend/scripts/ingest_pyqs.py) ---
# One or more free Gemini API keys, comma-separated; rotates on 429s. Falls
# back to GEMINI_API_KEY above if left empty.
GEMINI_PYQ_API_KEYS=
# Free-tier daily quota is per-project-per-model (often as low as 20
# requests/day for a flagship "flash" model), so a lighter model such as
# gemini-3.5-flash-lite gets its own, much larger quota bucket. Falls back to
# LLM_MODEL, then "gemini-2.5-flash", if left empty.
GEMINI_PYQ_MODEL=gemini-3.5-flash-lite
