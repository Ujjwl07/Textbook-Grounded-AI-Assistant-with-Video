APP_NAME=Generic Textbook Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=textbook_assistant

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=textbook-assistant/videos

VIDEO_OUTPUT_DIR=outputs/videos
CACHE_TTL_SECONDS=2592000
GENERATION_MOCK_DELAY_SECONDS=0.15

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=textbook_chunks
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Video assembly (Purnika) ---
VIDEO_FPS=24
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VMAKE_ENABLED=false
VMAKE_API_KEY=

# --- TTS / audio post-processing (Pallika) ---
AUDIO_TARGET_LUFS=-16.0
AUDIO_SILENCE_THRESHOLD_DB=-45.0
AUDIO_POSTPROCESS_ENABLED=true
VIDEO_PRESET=veryfast
VIDEO_THREADS=0
